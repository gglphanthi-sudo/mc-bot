# Cấu hình chạy - điền acc bot vào đây

# Dashboard: PORT là cổng, HOST=127.0.0.1 chạy local, HOST=0.0.0.0 khi deploy hosting
PORT=3000
HOST=127.0.0.1

# Tự kết nối lại khi bot bị rớt mạng / server restart (true/false)
AUTO_RECONNECT=true

SERVER_HOST=kingmc.vn
SERVER_PORT=25565

# ============ CẤU HÌNH ACC BOT ============
# Acc đầu tiên căn cứ vào BOT_1_USERNAME.
# PROXY bỏ trống nếu không dùng (socks5://[user:pass@]host:port).
# HOST/PORT bỏ trống để dùng SERVER_HOST/SERVER_PORT.

# ----- Acc 1 -----
BOT_1_USERNAME=
BOT_1_PASSWORD=
BOT_1_HOST=
BOT_1_PORT=

# ----- Acc 2 -----
BOT_2_USERNAME=
BOT_2_PASSWORD=
BOT_2_PROXY=
BOT_2_HOST=
BOT_2_PORT=

# ----- Acc 3 -----
BOT_3_USERNAME=
BOT_3_PASSWORD=
BOT_3_PROXY=
BOT_3_HOST=
BOT_3_PORT=

# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...