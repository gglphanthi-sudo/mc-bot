# Đổi tên file này thành .env rồi điền giá trị thật vào, KHÔNG commit file .env lên git

# Dashboard: PORT là cổng chạy, HOST=0.0.0.0 để mọi IP trong mạng/Internet truy cập được
# (chạy localhost dùng HOST=127.0.0.1). LƯU Ý: dashboard không có đăng nhập - nếu
# đặt HOST=0.0.0.0 mà mở port ra ngoài thì ai cũng điều khiển được, kể cả xem mật khẩu.
PORT=3000
HOST=0.0.0.0

# Tự kết nối lại khi bot bị rớt mạng / server restart (true/false)
AUTO_RECONNECT=true

# IP & port server mặc định (dùng khi acc không tự khai báo host/port riêng)
SERVER_HOST=kingmc.vn
SERVER_PORT=25565

# ============ CẤU HÌNH ACC BOT ============
# Điền lần lượt từng acc theo số thứ tự (BOT_1, BOT_2, BOT_3...).
# Acc đầu tiên căn cứ vào BOT_1_USERNAME - đã có username thì mới tính.
# PROXY: bỏ trống nếu không dùng. Định dạng: socks5://[user:pass@]host:port
# HOST/PORT: bỏ trống để dùng SERVER_HOST/SERVER_PORT

# ----- Acc 1 -----
BOT_1_USERNAME=acc1
BOT_1_PASSWORD=matkhau1
BOT_1_PROXY=
BOT_1_HOST=
BOT_1_PORT=

# ----- Acc 2 -----
BOT_2_USERNAME=acc2
BOT_2_PASSWORD=matkhau2
BOT_2_PROXY=socks5://user:pass@1.2.3.4:1080
BOT_2_HOST=
BOT_2_PORT=

# ----- Acc 3 (xóa hoặc để trống username nếu không dùng) -----
BOT_3_USERNAME=
BOT_3_PASSWORD=
BOT_3_PROXY=
BOT_3_HOST=
BOT_3_PORT=

# Webhook Discord (TÙY CHỌN) - thông báo khi bot vào/ra server
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...